# Gemma Validation Setup - Environment Variables
# Configured to work with local Ollama or LM Studio

# === LLM Configuration ===
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma:7b
LLM_TIMEOUT=120

# === Django Configuration ===
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
